{
  "vers": 1,
  "data": { "root": "{home}/.05-cloud-house-secre", "vaul": "forgejo-vault.json", "stat": "forgejo-state.json", "audi": "forgejo-audit.log", "acct": "forgejo-account.json" },
  "vaul": { "envz": "CLOUD_HOUSE_VAULT_PASS", "time": 3, "memo": 65536, "para": 1 },
  "repo": { "path": "{home}/05-cloud-house-synch", "bran": "main", "remo": "origin", "push": "ssh://git@{pubh}:{sshp}/{path}.git" },
  "rele": { "base": "https://codeberg.org/forgejo/forgejo/releases/download", "vers": "15.0.5", "arch": "linux-amd64", "file": "forgejo-{vers}-{arch}", "sums": ".sha256", "maxb": 268435456 },
  "host": { "bina": "/usr/local/bin/forgejo", "work": "/var/lib/forgejo", "conf": "/etc/forgejo/app.ini", "unit": "/etc/systemd/system/forgejo.service", "svcu": "git", "pubh": "127.0.0.1", "port": 3000, "sshp": 2222 },
  "ini": [
    "APP_NAME = cloud-house",
    "RUN_USER = {svcu}",
    "WORK_PATH = {work}",
    "RUN_MODE = prod",
    "",
    "[server]",
    "HTTP_ADDR = 127.0.0.1",
    "HTTP_PORT = {port}",
    "ROOT_URL = http://{pubh}:{port}/",
    "DOMAIN = {pubh}",
    "START_SSH_SERVER = true",
    "SSH_PORT = {sshp}",
    "SSH_LISTEN_PORT = {sshp}",
    "",
    "[database]",
    "DB_TYPE = sqlite3",
    "PATH = {work}/data/forgejo.db",
    "",
    "[security]",
    "INSTALL_LOCK = true",
    "",
    "[service]",
    "DISABLE_REGISTRATION = true",
    "REQUIRE_SIGNIN_VIEW = true",
    "",
    "[actions]",
    "ENABLED = false",
    "",
    "[packages]",
    "ENABLED = false",
    "",
    "[indexer]",
    "ISSUE_INDEXER_TYPE = db",
    "REPO_INDEXER_ENABLED = false",
    "",
    "[cache]",
    "ADAPTER = memory",
    "",
    "[session]",
    "PROVIDER = file",
    "",
    "[picture]",
    "DISABLE_GRAVATAR = true",
    "ENABLE_FEDERATED_AVATAR = false",
    "",
    "[federation]",
    "ENABLED = false",
    "",
    "[repository]",
    "DISABLE_DOWNLOAD_SOURCE_ARCHIVES = true",
    "",
    "[log]",
    "MODE = console",
    "LEVEL = warn"
  ],
  "unit": [
    "[Unit]",
    "Description=Forgejo (cloud-house)",
    "After=network.target",
    "",
    "[Service]",
    "User={svcu}",
    "WorkingDirectory={work}",
    "ExecStart={bina} web --config {conf}",
    "Restart=always",
    "MemoryMax=600M",
    "Nice=5",
    "",
    "[Install]",
    "WantedBy=multi-user.target"
  ],
  "bkup": {
    "onzz": true,
    "svcf": "/etc/systemd/system/forgejo-dump.service",
    "tmrf": "/etc/systemd/system/forgejo-dump.timer",
    "svc": [
      "[Unit]",
      "Description=Forgejo dump (one rolling copy)",
      "",
      "[Service]",
      "Type=oneshot",
      "User={svcu}",
      "Nice=10",
      "ExecStartPre=/bin/mkdir -p {work}/backup",
      "ExecStart=/bin/sh -c '{bina} dump --config {conf} --type zip --file {work}/backup/dump.new.zip && mv -f {work}/backup/dump.new.zip {work}/backup/dump.zip'"
    ],
    "tmr": [
      "[Unit]",
      "Description=Forgejo nightly dump",
      "",
      "[Timer]",
      "OnCalendar=daily",
      "RandomizedDelaySec=1h",
      "Persistent=true",
      "",
      "[Install]",
      "WantedBy=timers.target"
    ],
    "enab": ["systemctl", "enable", "--now", "forgejo-dump.timer"]
  },
  "limi": { "ramm": 1024, "diskm": 20480, "warn": 80 },
  "cmds": {
    "chek": ["id", "-u", "{svcu}"],
    "runa": ["runuser", "-u", "{svcu}", "--"],
    "mkus": ["useradd", "--system", "--create-home", "--home-dir", "{work}", "--shell", "/bin/bash", "{svcu}"],
    "chmo": ["chmod", "755", "{bina}"],
    "chow": ["chown", "-R", "{svcu}:{svcu}", "{work}"],
    "reld": ["systemctl", "daemon-reload"],
    "enab": ["systemctl", "enable", "--now", "forgejo"]
  },
  "admi": { "user": "", "mail": "" },
  "toke": { "name": "cloud-house", "scop": ["write:repository", "write:user"] },
  "frep": {
    "name": "cloud-house",
    "visi": "private",
    "sett": { "has_wiki": false, "has_issues": false, "has_projects": false, "has_pull_requests": false, "has_actions": false, "has_packages": false, "has_releases": false }
  },
  "prot": { "enable_push": true, "enable_force_push": false, "enable_merge_whitelist": false, "required_approvals": 0 },
  "sshz": { "file": "{home}/.ssh/id_ed25519_forgejo", "titl": "cloud-house" },
  "tool": { "gitz": "git", "sshk": "ssh-keygen", "time": 120 },
  "boot": { "poll": 2, "wait": 60 },
  "http": { "trys": 3, "back": 2, "maxw": 30, "agen": "forgejo-setup/0.1", "maxb": 1048576 },
  "guid": { "open": false, "clip": false, "poll": 3, "wait": 600 }
}
