{
  "note": "Catalog rows for the automation hub. The hub fires them; this app has no scheduler. All start OFF. One cron entry per cust for scan.",
  "jobs": [
    { "id": "zalochat-scan", "cmd": "scrape scan --cust <ID>", "trigger": "cron", "cron": "17 */6 * * *", "on": false, "tmoS": 900, "retry": 0 },
    { "id": "zalochat-oa-sync", "cmd": "scrape sync --cust <ID> --tier oa", "trigger": "cron", "cron": "7 * * * *", "on": false, "tmoS": 600, "retry": 0 },
    { "id": "zalochat-vendor-probe", "cmd": "scrape probe <vendor> <test-url>", "trigger": "cron", "cron": "0 3 * * 1", "on": false, "tmoS": 120, "retry": 0 },
    { "id": "zalochat-purge-old", "cmd": "scrape purge --old --cust <ID>", "trigger": "cron", "cron": "30 2 * * *", "on": false, "tmoS": 600, "retry": 0 }
  ]
}
